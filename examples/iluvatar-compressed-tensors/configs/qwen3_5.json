{
  "quant_method": "compressed-tensors",
  "format": "iluvatar-mixed",
  "config_groups": {
    "routed_experts": {
      "targets": [
        "re:.*\\.experts"
      ],
      "weights": {
        "num_bits": 4,
        "type": "int",
        "symmetric": {
          "$rules": "rules.routed_experts_gate_up_to_w4a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.routed_experts_gate_up_to_w4a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.routed_experts_gate_up_to_w4a8.quant.options.gemm_format"
        },
        "pack_version": {
          "$rules": "rules.routed_experts_gate_up_to_w4a8.quant.options.pack_version"
        },
        "wna16_use_w4a8": {
          "$rules": "rules.routed_experts_gate_up_to_w4a8.iluvatar.wna16_use_w4a8"
        }
      }
    },
    "dense_linears": {
      "format": "int-quantized",
      "targets": [
        "re:.*\\.self_attn\\.(q_proj|k_proj|v_proj|o_proj)$"
      ],
      "weights": {
        "num_bits": 8,
        "type": "int",
        "symmetric": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.gemm_format"
        },
        "mixed_strategy": {
          "$rules": "rules.dense_float_to_w8a8.iluvatar.mixed_strategy"
        },
        "gemm_mode": {
          "$rules": "rules.dense_float_to_w8a8.iluvatar.gemm_mode"
        }
      }
    }
  },
  "ignore": [
    "lm_head",
    "re:.*\\.embed_tokens$",
    "re:.*\\.visual\\..*",
    "re:.*mtp.*",
    "re:.*norm.*",
    "re:.*\\.linear_attn\\..*",
    "re:.*\\.mlp\\.gate$",
    "re:.*\\.mlp\\.shared_expert_gate$",
    "re:.*shared_expert.*"
  ]
}
