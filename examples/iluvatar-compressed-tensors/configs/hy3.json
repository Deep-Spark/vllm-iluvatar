{
  "quant_method": "compressed-tensors",
  "format": "iluvatar-mixed",
  "config_groups": {
    "routed_experts": {
      "targets": [
        "re:.*\\.experts"
      ],
      "weights": {
        "num_bits": 4,
        "type": "int",
        "symmetric": {
          "$rules": "rules.routed_static_fp8_to_w4a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.routed_static_fp8_to_w4a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.routed_static_fp8_to_w4a8.quant.options.gemm_format"
        },
        "pack_version": {
          "$rules": "rules.routed_static_fp8_to_w4a8.quant.options.pack_version"
        }
      }
    },
    "dense_linears": {
      "format": "int-quantized",
      "targets": [
        "re:.*\\.mlp\\.(gate_up_proj|down_proj)$",
        "re:.*\\.self_attn\\.(qkv_proj|o_proj)$"
      ],
      "weights": {
        "num_bits": 8,
        "type": "int",
        "symmetric": {
          "$rules": "rules.dense_static_fp8_to_w8a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.dense_static_fp8_to_w8a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.dense_static_fp8_to_w8a8.quant.options.gemm_format"
        },
        "mixed_strategy": {
          "$rules": "rules.dense_static_fp8_to_w8a8.iluvatar.mixed_strategy"
        },
        "gemm_mode": {
          "$rules": "rules.dense_static_fp8_to_w8a8.iluvatar.gemm_mode"
        }
      }
    }
  },
  "ignore": [
    "embed",
    "lm_head",
    "norm",
    "re:.*\\.input_layernorm$",
    "re:.*\\.post_attention_layernorm$",
    "re:.*\\.self_attn\\.(q_norm|k_norm)$",
    "re:.*\\.(enorm|hnorm|final_layernorm)$",
    "re:.*\\.mlp\\.gate$",
    "re:.*\\.eh_proj$"
  ]
}
