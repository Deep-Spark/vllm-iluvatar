{
  "quant_method": "compressed-tensors",
  "format": "iluvatar-mixed",
  "config_groups": {
    "routed_experts": {
      "targets": [
        "re:.*\\.moe\\.experts",
        "re:.*\\.experts"
      ],
      "weights": {
        "num_bits": 4,
        "type": "int",
        "symmetric": {
          "$rules": "rules.routed_fp8_to_w4a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.routed_fp8_to_w4a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.routed_fp8_to_w4a8.quant.options.gemm_format"
        },
        "pack_version": {
          "$rules": "rules.routed_fp8_to_w4a8.quant.options.pack_version"
        }
      }
    },
    "dense_linears": {
      "format": "int-quantized",
      "targets": [
        "re:.*\\.self_attn\\.(qkv_proj|o_proj)$",
        "re:.*\\.share_expert\\.(gate_up_proj|down_proj)$",
        "re:.*\\.mlp\\.(gate_up_proj|down_proj)$"
      ],
      "weights": {
        "num_bits": 8,
        "type": "int",
        "symmetric": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.symmetric"
        },
        "strategy": "channel",
        "group_size": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.group_size",
          "none_as": -1
        },
        "dynamic": false
      },
      "input_activations": {
        "num_bits": 8,
        "type": "int",
        "symmetric": true,
        "strategy": "token",
        "group_size": null,
        "dynamic": true
      },
      "output_activations": null,
      "iluvatar": {
        "gemm_format": {
          "$rules": "rules.dense_float_to_w8a8.quant.options.gemm_format"
        },
        "mixed_strategy": {
          "$rules": "rules.dense_float_to_w8a8.iluvatar.mixed_strategy"
        },
        "gemm_mode": {
          "$rules": "rules.dense_float_to_w8a8.iluvatar.gemm_mode"
        }
      }
    }
  },
  "ignore": [
    "lm_head",
    "embed_tokens",
    "re:.*norm.*",
    "re:.*\\.self_attn\\.(q_norm|k_norm|g_proj)$",
    "re:.*\\.moe\\.gate$",
    "re:.*e_score_correction_bias$",
    "re:.*\\.(enorm|hnorm|eh_proj)$",
    "re:.*\\.shared_head\\..*",
    "re:.*\\.mtp_block\\..*",
    "re:.*\\.vision_model\\..*",
    "re:.*\\.vit_large_projector\\..*"
  ]
}
